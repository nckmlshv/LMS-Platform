Enum user_status {
  active
  blocked
  deleted
}

Enum user_role {
  student
  author
  advisor
}

Enum gender_type {
  male
  female
}

Enum role_name {
  author
  student
  advisor
  admin
}

Enum email_notifications_type {
  all
  important
  no
}

Table users {
  id bigint [pk, increment]
  first_name varchar(24) [not null]
  middle_name varchar(24)
  last_name varchar(24) [not null]
  gender gender_type
  date_of_birth date [not null]
  email varchar(64) [not null, unique]
  password_hash varchar(255) [not null]
  phone_number varchar(20)
  avatar_url text
  status user_status [not null, default: 'active']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  Note: "Основная учетная запись пользователя"
}

Table user_roles {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  role user_role [not null]
  assigned_at timestamp [not null]
  assigned_by bigint [note: "user_id администратора или системы"]

  Note: "Связь между пользователями и ролями"
}

Table user_settings {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: > users.id]
  email_notifications email_notifications_type [not null, default: 'all']
  sms_notifications boolean [not null, default: false]
  preferred_language varchar(10)
  timezone varchar(64)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: "Пользовательские настройки"
}

Table user_sessions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  refresh_token_hash varchar(255) [not null]
  user_agent text
  ip_address varchar(64)
  expires_at timestamp [not null]
  created_at timestamp [not null]
  revoked_at timestamp

  Note: "Сессии пользователей"
}

Table user_audit_logs {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id, note: "Над кем выполнено действие"]
  action text [not null]
  changed_by bigint [note: "Кто выполнил действие"]
  old_value json
  new_value json
  created_at timestamp [not null]

  Note: "Журнал изменений"
}

Table user_favorites {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  course_id bigint [not null]
  created_at timestamp [not null]

  Note: "Избранные курсы пользователя"
}
